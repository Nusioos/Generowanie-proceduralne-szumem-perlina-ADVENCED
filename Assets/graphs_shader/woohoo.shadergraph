{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "4519e398cfb8470f9fd32a4b00b614e5",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "LightDirection (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1054.0,
            "y": -55.00001907348633,
            "width": 234.0,
            "height": 302.0000305175781
        }
    },
    "m_Slots": [
        {
            "m_Id": "5e66f96f32b2441fab7f494a46b4c642"
        },
        {
            "m_Id": "1ff36ae8866448a1830b9351e8e5a301"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "LightDirection",
    "m_FunctionSource": "",
    "m_FunctionBody": "#if SHADERGRAPH_PREVIEW\r\n    Direction = half3(0.5, 0.5, 0);\r\n    Color = 1;\r\n#else\r\n    // Define a function to get the spotlight properties\r\n    SpotLight GetSpotLight()\r\n    {\r\n        SpotLight spotLight;\r\n        // Assuming you have access to the spot light properties\r\n        // You may need to define these functions or properties according to your setup\r\n        spotLight.direction = _SpotLightDirection; // This should be defined in your shader or passed as a parameter\r\n        spotLight.color = _SpotLightColor;         // This should be defined in your shader or passed as a parameter\r\n        return spotLight;\r\n    }\r\n\r\n    // Fetch the spotlight properties\r\n    SpotLight spotLight = GetSpotLight();\r\n    Direction = spotLight.direction;\r\n    Color = spotLight.color;\r\n#endif\r\n"
}

