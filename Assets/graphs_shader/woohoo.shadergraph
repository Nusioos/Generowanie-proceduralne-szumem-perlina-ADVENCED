            "height": 350.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "f482ddc880cf4453920a80020149bdaa"
        },
        {
            "m_Id": "e1c591110dd543afa67228ab8b13a63c"
        },
        {
            "m_Id": "37073595f7db411285902439e3bd490f"
        },
        {
            "m_Id": "c7e8b8f8ce614ce7b8e57aa752376a98"
        },
        {
            "m_Id": "1eb7a09b07eb42c89c478029ec08dc04"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "MainLight",
    "m_FunctionSource": "1d2060d08eee147418bd2a2b15cb2bba",
    "m_FunctionBody": "\r\n\r\n\r\nvoid MainLight_float(float3 WorldPos, out float3 Direction, out float3 Color, out float DistanceAtten, out float ShadowAtten)\r\n{\r\n#ifdef SHADERGRAPH_PREVIEW\r\nDirection= float3(0.5, 0.5, 0);\r\nColor = 1;\r\nDistanceAtten = 1;\r\nShadowAtten = 1;\r\n#else\r\nfloat4 shadowCoord = TransformWorldToShadowCoord (WorldPos);\r\nLight mainLight GetMainLight shadowCoord);\r\nDirection mainLight.direction;\r\nColor=mainLight.color;\r\nDistanceAtten mainLight.distanceAttenuation;\r\n#if !defined(_MAIN_LIGHT_SHADOWS) || defined(_RECEIVE_SHADOWS_OFF) ShadowAtten = 1.0h;\r\n#else\r\nShadowSamplingData shadowSamplingData = GetMainLightShadowSamplingData(); float shadowStrength = GetMainLightShadowStrength();\r\nShadowAtten\r\nSampleShadowmap(shadowCoord, TEXTURE2D_ARGS (_MainLightShadowmapTexture,\r\nsampler MainLightShadowmapTexture),\r\nshadowSamplingData, shadowStrength, false);\r\n#endif\r\n#endif\r\n}"
}

