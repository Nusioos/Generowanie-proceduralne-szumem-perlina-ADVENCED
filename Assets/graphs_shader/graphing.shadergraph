    "m_SourceType": 0,
    "m_FunctionName": "MainLight",
    "m_FunctionSource": "1d2060d08eee147418bd2a2b15cb2bba",
    "m_FunctionBody": "void Lightcelshaded_float (out float3 Color)\r\n{\r\n#if SHADERGRAPH_PREVIEW\r\n       Direction= half3(0.5,0.5,0);\r\n        Color =1;\r\n#else\r\n         Light light = GetMainLight();\r\n         Direction=light.direction;\r\n         Color =light.color;\r\n#endif\r\n\r\n}"
}

