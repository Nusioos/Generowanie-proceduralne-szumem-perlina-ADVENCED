{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "81e22e137c084ea2bdfd0713787d6205",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Custom Function",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -671.7932739257813,
            "y": -174.988037109375,
            "width": 0.0,
            "height": 0.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "3d8dda99e8774922a6cf09c8e3ca4d11"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Enter function name here...",
    "m_FunctionSource": "",
    "m_FunctionBody": "Shader \"Custom/NewSurfaceShader\"\n{\n    Properties\n    {\n        _WaterFogColor (\"Water Fog Color\", Color) = (0, 0, 0, 0)\n        _WaterFogDensity (\"Water Fog Density\", Range(0, 5)) = 0.1\n        _RefractionStrength (\"Refraction Strength\", Range(0, 10)) = 0.25\n        _Color (\"Color\", Color) = (1,1,1,1)\n        _MainTex (\"Albedo (RGB)\", 2D) = \"white\" {}\n        _Glossiness (\"Smoothness\", Range(0,1)) = 0.5\n        _Metallic (\"Metallic\", Range(0,1)) = 0.0\n        _BumpMap(\"Normal Map\", 2D) = \"bump\" {}\n        _FresnelPower (\"Fresnel Power\", Range(0.1, 5.0)) = 1.0\n        _FresnelColor (\"Fresnel Color\", Color) = (1, 1, 1, 1)\n        _WaveA (\"Wave A (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveB (\"Wave B (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveC (\"Wave C (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveD (\"Wave D (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveE (\"Wave E (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveF (\"Wave F (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveG (\"Wave G (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveH (\"Wave H (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveI (\"Wave I (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveJ (\"Wave J (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveK (\"Wave K (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveL (\"Wave L (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveM (\"Wave M (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveN (\"Wave N (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveO (\"Wave O (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveP (\"Wave P (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveQ (\"Wave Q (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveR (\"Wave R (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveS (\"Wave S (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveT (\"Wave T (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveU (\"Wave U (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _WaveV (\"Wave V (dir, steepness, wavelength)\", Vector) = (1,0,0.5,10)\n        _BrownianAmplitude (\"Brownian Amplitude\", Range(0, 1)) = 0.1\n        _BrownianFrequency (\"Brownian Frequency\", Range(0, 10)) = 1.0\n        _NoiseScale (\"Noise Scale\", Range(0.1, 10.0)) = 1.0\n        _NoiseIntensity (\"Noise Intensity\", Range(0.0, 1.0)) = 0.1\n    }\n    SubShader\n    {\n     \n        Tags {\"RenderPipeline\" = \"UniversalPipeline\" \"RenderType\"=\"Transparent\" \"Queue\"=\"Transparent\"}\n        LOD 200\n        GrabPass {\"_WaterBackground\"}\n        HLSLPROGRAM\n        #pragma surface surf Standard alpha finalcolor:ResetAlpha fullforwardshadows vertex:vert addshadow\n        #pragma target 3.0\n      \n        sampler2D _MainTex;\n        sampler2D _BumpMap;\n        sampler2D _CameraDepthTexture, _WaterBackground;\n        float4 _CameraDepthTexture_TexelSize;\n\n        struct Input\n        {\n            float2 uv_MainTex;\n            float2 uv_BumpMap;\n            float3 viewDir;\n            float4 screenPos;\n        };\n\n        float _RefractionStrength;\n        float4 _WaveA, _WaveB, _WaveC, _WaveD, _WaveE, _WaveF, _WaveG, _WaveH, _WaveI, _WaveJ;\n        float4 _WaveK, _WaveL, _WaveM, _WaveN, _WaveO, _WaveP, _WaveQ, _WaveR, _WaveS, _WaveT;\n        float4 _WaveU, _WaveV;\n        float _BrownianAmplitude;\n        float _BrownianFrequency;\n        half _FresnelPower;\n        fixed4 _FresnelColor;\n        float _NoiseScale;\n        float _NoiseIntensity;\n        float3 _WaterFogColor;\n        float _WaterFogDensity;\n\n        #if !defined(LOOKING_THROUGH_WATER_INCLUDED)\n        #define LOOKING_THROUGH_WATER_INCLUDED\n        float3 ColorBelowWater(float4 screenPos, float3 tangentSpaceNormal)\n        {\n            float2 uvOffset = tangentSpaceNormal.xy * _RefractionStrength;\n            uvOffset.y *= _CameraDepthTexture_TexelSize.z * abs(_CameraDepthTexture_TexelSize.y);\n            float2 uv = (screenPos.xy + uvOffset) / screenPos.w;\n            #if UNITY_UV_STARTS_AT_TOP\n            if (_CameraDepthTexture_TexelSize.y < 0) { uv.y = 1 - uv.y; }\n            #endif\n            float backgroundDepth = LinearEyeDepth(SAMPLE_DEPTH_TEXTURE(_CameraDepthTexture, uv));\n            float surfaceDepth = UNITY_Z_0_FAR_FROM_CLIPSPACE(screenPos.z);\n            float depthDifference = backgroundDepth - surfaceDepth;\n            float3 backgroundColor = tex2D(_WaterBackground, uv).rgb;\n            float fogFactor = exp2(-_WaterFogDensity * depthDifference);\n            return lerp(_WaterFogColor, backgroundColor, fogFactor);\n        }\n        #endif\n\n        void ResetAlpha(Input IN, SurfaceOutputStandard o, inout fixed4 color) { color.a = 1; }\n\n        float hash(float n) { return frac(sin(n) * 43758.5453123); }\n        float noise(float3 p)\n        {\n            float3 i = floor(p);\n            float3 f = frac(p);\n            f = f * f * (3.0 - 2.0 * f);\n            float n = dot(i, float3(1.0, 57.0, 113.0));\n            return lerp(lerp(lerp(hash(n +  0.0), hash(n +  1.0), f.x),\n                             lerp(hash(n + 57.0), hash(n + 58.0), f.x), f.y),\n                        lerp(lerp(hash(n + 113.0), hash(n + 114.0), f.x),\n                             lerp(hash(n + 170.0), hash(n + 171.0), f.x), f.y), f.z);\n        }\n\n        float3 domainWarp(float3 p)\n        {\n            float3 q = p;\n            q.x += _NoiseIntensity * noise(p * _NoiseScale);\n            q.z += _NoiseIntensity * noise(p * _NoiseScale + float3(5.2, 1.3, 2.1));\n            return q;\n        }\n\n        float3 GerstnerWave(float4 wave, float3 p, inout float3 tangent, inout float3 binormal)\n        {\n            float steepness = wave.z;\n            float wavelength = wave.w;\n            float k = 2 * UNITY_PI / wavelength;\n            float c = sqrt(0.98 / k);\n            float2 d = normalize(wave.xy);\n            float f = k * (dot(d, p.xz) - c * _Time.y);\n            float a = steepness / k;\n            tangent += float3(\n                -d.x * d.x * steepness,\n                d.x * steepness * pow(2.71828, sin(f)) * cos(f),\n                -d.x * d.y * steepness\n            );\n            binormal += float3(\n                -d.x * d.y * steepness,\n                d.y * steepness * pow(2.71828, sin(f)) * cos(f),\n                -d.y * d.y * steepness\n            );\n            return float3(\n                d.x * a,\n                a * pow(2.71828, sin(f) + 1.8),\n                d.y * a\n            );\n        }\n\n        float BrownianMotion(float3 p)\n        {\n            float randomValue = frac(sin(dot(p.xyz, float2(12.9898, 78.233))) * 43758.5453);\n            float offset = (randomValue - 0.5) * 2.0;\n            return offset * _BrownianAmplitude * sin(_BrownianFrequency * _Time.y);\n        }\n\n        void vert(inout appdata_full vertexData)\n        {\n            float3 gridPoint = vertexData.vertex.xyz;\n            float3 tangent = float3(1, 0, 0);\n            float3 binormal = float3(0, 0, 1);\n\n            // Apply domain warping\n            float3 warpedGridPoint = domainWarp(gridPoint);\n\n            float3 p = gridPoint;\n            float4 waves[22] = {\n                _WaveA, _WaveB, _WaveC, _WaveD, _WaveE, _WaveF, _WaveG, _WaveH, _WaveI,\n                _WaveJ, _WaveK, _WaveL, _WaveM, _WaveN, _WaveO, _WaveP, _WaveQ, _WaveR,\n                _WaveS, _WaveT, _WaveU, _WaveV\n            };\n\n            for (int i = 0; i < 22; i++) {\n                p += GerstnerWave(waves[i], warpedGridPoint, tangent, binormal);\n            }\n\n            p.y += BrownianMotion(warpedGridPoint); // Add Brownian motion to the y-axis\n\n            float3 normal = normalize(cross(binormal, tangent));\n\n            vertexData.vertex.xyz = p;\n            vertexData.normal = normal;\n        }\n\n        half _Glossiness;\n        half _Metallic;\n        fixed4 _Color;\n\n        UNITY_INSTANCING_BUFFER_START(Props)\n        UNITY_INSTANCING_BUFFER_END(Props)\n\n        void surf (Input IN, inout SurfaceOutputStandard o)\n        {\n            // Albedo comes from a texture tinted by color\n            fixed4 c = tex2D(_MainTex, IN.uv_MainTex) * _Color;\n            o.Albedo = c.rgb;\n\n            // Apply normal mapping\n            o.Normal = UnpackNormal(tex2D(_BumpMap, IN.uv_BumpMap));\n\n            // Compute the Fresnel effect\n            float3 worldNormal = normalize(o.Normal);\n            float3 viewDir = normalize(IN.viewDir);\n            float fresnelFactor = pow(1.0 - dot(viewDir, worldNormal), _FresnelPower);\n            fixed4 fresnelColor = _FresnelColor * fresnelFactor;\n\n            // Blend Fresnel effect with the base color\n            o.Albedo = lerp(o.Albedo, fresnelColor.rgb, fresnelFactor);\n\n            // Metallic and smoothness come from slider variables\n            o.Metallic = _Metallic;\n            o.Smoothness = _Glossiness;\n            o.Alpha = c.a;\n            o.Emission = ColorBelowWater(IN.screenPos, o.Normal) * (1 - c.a);\n            o.Albedo = ColorBelowWater(IN.screenPos, o.Normal);\n\n        }\n        ENDHLSL\n    }\n    //  FallBack \"Diffuse\"\n}"
}

